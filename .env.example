# Meta Pixel — ID do Dataset (Pixel) criado no Events Manager
NEXT_PUBLIC_FB_PIXEL_ID=

# Endpoint publico de rastreamento; o build precisa desta variavel para incluir o tracking no site.
NEXT_PUBLIC_TRACK_URL=https://swhexygjwqnfxlsrnnam.supabase.co/functions/v1/track

# Webhook do n8n — pré-cadastro (recebe o lead -> dispara CAPI + grava na planilha)
NEXT_PUBLIC_PRECADASTRO_WEBHOOK=https://primary-production-5215.up.railway.app/webhook/pre-cadastro

# Webhook do n8n — candidatura mentoria (CAPI Lead + SubmitApplication com fit + CRM)
NEXT_PUBLIC_CANDIDATURA_WEBHOOK=https://primary-production-5215.up.railway.app/webhook/candidatura-mentoria

# Rota publica que devolve { vendas: N } — vendas da Comunidade no CRM.
# A pagina /comunidade usa esse numero para saber quantas das 10 vagas restam.
NEXT_PUBLIC_COMUNIDADE_VENDAS_URL=https://swhexygjwqnfxlsrnnam.supabase.co/functions/v1/comunidade-vendas
